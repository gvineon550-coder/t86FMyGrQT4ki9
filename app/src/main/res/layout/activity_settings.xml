<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1115">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Настройки"
            android:textColor="#e6e6e6"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/item_playlists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="📺  Плейлисты"
            android:textColor="#e6e6e6"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/item_epg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="📅  Программа передач (EPG)"
            android:textColor="#e6e6e6"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/item_decoder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="🎞  Декодер"
            android:textColor="#e6e6e6"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/item_sleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="⏰  Таймер сна"
            android:textColor="#e6e6e6"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/item_parental"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="🔒  Родительский контроль"
            android:textColor="#e6e6e6"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/item_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="🎨  Тема оформления"
            android:textColor="#e6e6e6"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/item_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="ℹ️  О приложении"
            android:textColor="#e6e6e6"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
</ScrollView>
